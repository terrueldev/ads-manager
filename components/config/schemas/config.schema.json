{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "config.schema.json",
  "title": "Project Configuration Schema",
  "description": "Schema for SDD project configuration. Users extend this as config evolves.",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "description": "Reserved for future cross-cutting concerns",
      "additionalProperties": true
    },
    "ads-manager-db": {
      "type": "object",
      "properties": {
        "host": { "type": "string" },
        "port": { "type": "number", "default": 5432 },
        "name": { "type": "string" },
        "user": { "type": "string" },
        "passwordSecret": { "type": "string" },
        "pool": { "type": "number", "default": 10 }
      },
      "required": ["host", "port", "name", "user", "passwordSecret"]
    },
    "ads-manager-server": {
      "type": "object",
      "properties": {
        "port": { "type": "number" },
        "probesPort": { "type": "number" },
        "logLevel": { "type": "string" },
        "database": {
          "type": "object",
          "properties": {
            "host": { "type": "string" },
            "port": { "type": "number" },
            "name": { "type": "string" },
            "user": { "type": "string" },
            "passwordSecret": { "type": "string" },
            "pool": { "type": "number" }
          }
        },
        "googleOAuth": {
          "type": "object",
          "description": "Google OAuth client for the Google Ads Connection flow. Values are placeholders here — real values come from env vars (GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET / GOOGLE_OAUTH_REDIRECT_URI), never from this file.",
          "properties": {
            "clientId": { "type": "string" },
            "clientSecret": { "type": "string" },
            "redirectUri": { "type": "string" }
          }
        },
        "googleAds": {
          "type": "object",
          "description": "Google Ads API developer token. Real value comes from GOOGLE_ADS_DEVELOPER_TOKEN env var, never from this file.",
          "properties": {
            "developerToken": { "type": "string" }
          }
        }
      }
    },
    "ads-manager-webapp": {
      "type": "object",
      "properties": {
        "apis": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "base_url": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
