# Copy this file to .env in this same directory (components/servers/ads-manager-server/.env)
# and fill in real values. .env is gitignored — never commit real credentials.

# --- Database ---
DB_PASSWORD=

# --- Google OAuth (Google Cloud Console > APIs & Services > Credentials) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional: overrides the redirectUri from components/config/envs/*/config.yaml
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/contas/callback

# --- Google Ads API (Google Ads MCC account > Tools & Settings > API Center) ---
GOOGLE_ADS_DEVELOPER_TOKEN=

# --- Token encryption ---
# 32 random bytes, base64-encoded. Generate your own — do NOT reuse this example value.
# One-liner: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# --- Set to false (or omit) to use the real Google OAuth/Google Ads adapters instead of mocks ---
MOCK_GOOGLE_ADS=false
